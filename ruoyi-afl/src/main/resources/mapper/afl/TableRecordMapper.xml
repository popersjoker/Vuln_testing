<!--            <if test="yid != null">yid = #{yid},</if>-->
<!--            <if test="cid != null">cid = #{cid},</if>-->
<!--            <if test="uid != null">uid = #{uid},</if>-->
<!--            <if test="uuid != null">uuid = #{uuid},</if>-->
<!--        </trim>-->
<!--        where uuid = #{uuid}-->
<!--    </update>-->

    <delete id="deleteTableRecordByFid" parameterType="Long">
        delete from table_record where fid = #{fid}
    </delete>

    <delete id="deleteTableRecordByFids" parameterType="String">
        delete from table_record where fid in
        <foreach item="fid" collection="array" open="(" separator="," close=")">
            #{fid}
        </foreach>
    </delete>
</mapper>
