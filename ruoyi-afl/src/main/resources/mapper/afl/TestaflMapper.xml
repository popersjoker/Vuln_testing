<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.afl.mapper.TestaflMapper">
    
    <resultMap type="Testafl" id="TestaflResult">
        <result property="fid"    column="fid"    />
        <result property="name"    column="name"    />
    </resultMap>

    <sql id="selectTestaflVo">
        select fid, name from testafl
    </sql>

    <select id="selectTestaflList" parameterType="Testafl" resultMap="TestaflResult">
        <include refid="selectTestaflVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
    
    <select id="selectTestaflByFid" parameterType="Long" resultMap="TestaflResult">
        <include refid="selectTestaflVo"/>
        where fid = #{fid}
    </select>
        
    <insert id="insertTestafl" parameterType="Testafl" useGeneratedKeys="true" keyProperty="fid">
        insert into testafl
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
         </trim>
    </insert>

    <update id="updateTestafl" parameterType="Testafl">
        update testafl
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
        </trim>
        where fid = #{fid}
    </update>

    <delete id="deleteTestaflByFid" parameterType="Long">
        delete from testafl where fid = #{fid}
    </delete>

    <delete id="deleteTestaflByFids" parameterType="String">
        delete from testafl where fid in 
        <foreach item="fid" collection="array" open="(" separator="," close=")">
            #{fid}
        </foreach>
    </delete>
</mapper>